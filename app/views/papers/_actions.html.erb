<% if current_user.aeic? %>
<div class="card" id="track-info">
  <div class="card-header">Track</div>
  <div class="card-body">
  <% if paper.meta_review_issue_id %>

    <% if paper.track %>
      <p class="card-text">
        This paper is assigned to the track: <strong><%= paper.track.name %></strong>.
      </p>
      <p class="card-text">
        This track is managed by:
        <ul>
          <% paper.track.aeics.each do |aeic| %>
            <li><%= aeic.full_name %> (<%= aeic.login %>)</li>
          <% end %>
          <%= "Track without AEiC" if paper.track.aeics.empty? %>
        </ul>
      </p>
    <% else %>
    <p class="card-text">
      This paper is <strong>not assigned to any track</strong>
      </p>
    <% end %>
  <% else %>
    <% if paper.suggested_subject %>
      <p class="card-text">
        Author suggested this paper' subject is <strong><%= paper.suggested_subject %></strong>
      </p>
    <% else %>
      <p class="card-text">
        Author didn't suggest any subject for this paper.
      </p>
    <% end %>

    <% if paper.track_id.present? %>
      <p class="card-text">
        This submission will be assigned to the track:  <strong><%= paper.track.name %></strong>
      </p>
      <p class="card-text">
        <%= paper.track.aeics.empty? ? "Track without AEiC" : "Track managed by:" %>
        <ul>
          <% paper.track.aeics.each do |aeic| %>
            <li><%= aeic.full_name %> (<%= aeic.login %>)</li>
          <% end %>
        </ul>
      </p>
      <% end %>
  <% end %>

  <%= link_to "Change track &raquo;".html_safe, "#changeTrack", title: "Change submission's track", data: { toggle: 'collapse'} %>

    <div class="row collapse" id="changeTrack">
      <div class="col-md-6">
        <%= form_tag(change_track_paper_url(paper), class: "left") do %>
          <%= select_tag :track_id, options_from_collection_for_select(Track.where.not(id: paper.track_id), "id", "name"), prompt: "Select new track", class: "form-control left" %>
          <%= submit_tag "Change paper's track", class: "btn btn-primary left change-track" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<br />
<% end %>

<% if current_user.aeic? || (current_user == paper.submitting_author) %>
  <!-- Resubmission Information -->
  <% if paper.is_resubmission_with_doi? %>
    <div class="card" id="resubmission-info">
      <div class="card-header">
        <span class="badge badge-info">Resubmission</span> Resubmission Information
      </div>
      <div class="card-body">
        <p class="card-text">
          <strong>Submission Type:</strong> Resubmission<br>
          <strong>Original DOI:</strong> <code><%= paper.existing_submission_doi %></code>
          <% issue_number = paper.existing_github_issue_number %>
          <% if issue_number %>
            <br><strong>GitHub Issue:</strong> #<%= issue_number %>
            <% issue_status = paper.existing_github_issue_status %>
            <span class="badge badge-<%= issue_status[:status] == :closed ? 'secondary' : 'success' %>">
              <%= issue_status[:status].to_s.humanize %>
            </span>
          <% end %>
        </p>

        <% if current_user.aeic? && paper.can_reopen_github_issue? %>
          <button id="reopen-github-issue-btn"
                  class="btn btn-warning"
                  data-paper-id="<%= paper.id %>"
                  data-issue-number="<%= issue_number %>">
            <i class="fa fa-redo"></i> Reopen Review Issue #<%= issue_number %>
          </button>
          <div id="reopen-result" class="mt-2" style="display: none;"></div>
        <% elsif current_user.aeic? %>
          <p class="text-muted">
            <% case paper.existing_github_issue_status[:status] %>
            <% when :open %>
              GitHub issue #<%= issue_number %> is already open.
            <% when :not_found %>
              GitHub issue #<%= issue_number %> was not found.
            <% when :error %>
              Error checking GitHub issue status.
            <% end %>
          </p>
        <% end %>
      </div>
    </div>
    <br />
  <% end %>

  <div class="card">
    <div class="card-header">
      Paper actions
    </div>
    <div class="card-body">
      <% if paper.submission_kind == 'resubmission' %>
        <p class="card-text">If you want to withdraw the resubmission, you can do so here:</p>
        <div class="row">
          <% if current_user.aeic? %>
            <div class="col-md-3">
              <%= link_to "Withdraw resubmission", withdraw_paper_path(paper), data: { turbo_method: :post, turbo_confirm: "Withdrawing resubmission. Are you sure?" }, form_class: "left", class: "btn btn-danger" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="card-text">Available actions for you on this paper (note to editors that if you use these buttons, you'll still have to manually close the review issue on GitHub).</p>
        <div class="row">
          <% if current_user.aeic? %>
            <% unless paper.meta_review_issue_id %>
            <div class="col-md-5">
              <%= form_tag(start_meta_review_paper_url(paper), class: "left") do %>
                Editor: <%= select_tag :editor, options_for_select(Repository.editors, selected: nil), prompt: "Suggest editor (optional)", class: "form-control left" %>
                <%= submit_tag "Start pre review", class: "btn btn-primary left start-review" %>
              <% end %>
            </div>
            <div class="col-md-1">
            </div>
            <% end %>

            <% unless paper.review_issue_id %>
            <div class="col-md-3">
              <%= link_to "Reject paper", reject_paper_path(paper), data: { turbo_method: :post, turbo_confirm: "Rejecting. Are you sure?" }, form_class: "left", class: "btn btn-danger" %>
            </div>
            <% end %>
          <% end %>

          <% if current_user.aeic? %>
            <div class="col-md-3">
              <%= link_to "Withdraw paper", withdraw_paper_path(paper), data: { turbo_method: :post, turbo_confirm: "Withdrawing. Are you sure?" }, form_class: "left", class: "btn btn-danger" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <br />

  <!-- JavaScript for Reopen GitHub Issue functionality -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const reopenBtn = document.getElementById('reopen-github-issue-btn');
    if (reopenBtn) {
      reopenBtn.addEventListener('click', function() {
        const paperId = this.dataset.paperId;
        const issueNumber = this.dataset.issueNumber;
        const resultDiv = document.getElementById('reopen-result');

        // Disable button and show loading state
        this.disabled = true;
        this.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Reopening...';

        // Make AJAX request
        fetch(`/papers/${paperId}/reopen_github_issue`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('[name="csrf-token"]').getAttribute('content')
          }
        })
        .then(response => response.json())
        .then(data => {
          resultDiv.style.display = 'block';

          if (data.success) {
            resultDiv.innerHTML = `
              <div class="alert alert-success">
                <i class="fa fa-check"></i> ${data.message}
                <br><a href="https://github.com/<%= Rails.application.settings["reviews"] %>/issues/${data.issue_number}" target="_blank">
                  View reopened issue #${data.issue_number} <i class="fa fa-external-link-alt"></i>
                </a>
              </div>
            `;
            // Update the badge to show as open
            const badge = document.querySelector('#resubmission-info .badge');
            if (badge) {
              badge.className = 'badge badge-success';
              badge.textContent = 'Open';
            }
            // Hide the button since issue is now open
            this.style.display = 'none';
          } else {
            resultDiv.innerHTML = `
              <div class="alert alert-danger">
                <i class="fa fa-exclamation-triangle"></i> ${data.error}
              </div>
            `;
            // Re-enable button
            this.disabled = false;
            this.innerHTML = '<i class="fa fa-redo"></i> Reopen Review Issue #' + issueNumber;
          }
        })
        .catch(error => {
          console.error('Error:', error);
          resultDiv.style.display = 'block';
          resultDiv.innerHTML = `
            <div class="alert alert-danger">
              <i class="fa fa-exclamation-triangle"></i> An error occurred while reopening the issue.
            </div>
          `;
          // Re-enable button
          this.disabled = false;
          this.innerHTML = '<i class="fa fa-redo"></i> Reopen Review Issue #' + issueNumber;
        });
      });
    }
  });
  </script>
<% end %>
