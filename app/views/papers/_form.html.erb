<%= form_for paper do |f| %>
<div class="form-group">
  <%= render partial: "shared/errors", locals: { object: paper } if paper.errors.any? %>
  <%- if paper_types.present? %>
    <dl class="clear full">
      <dt><%= f.label :kind, "Type" %></dt>
      <dt><%= f.select :kind, paper_types %></dt>
    </dl>
  <%- end %>
</div>

<div class="form-group">
  <div class="row">
    <div class="col">
      <%= f.label :title do %>Title<%= required_mark %><% end %>
      <%= f.text_field :title, placeholder: "What's the title of this preprint?", class: "form-control", required: true %>
    </div>

    <div class="col">
      <%= f.label :repository_url do %>Preprint's Git repository URL<%= required_mark %><% end %>
      <%= f.text_field :repository_url, placeholder: "e.g. https://github.com/neurolibre/template", class: "form-control", required: true %>
    </div>
  </div>
</div>

<div class="form-group">
  <div class="row">
    <div class="col">
      <%= f.label :git_branch, "Name of git branch containing the paper" %>
      <%= f.text_field :git_branch, class: "form-control" %>
      <small class="form-text text-muted">The branch name, not a path. Leave as main unless the paper is on another branch.</small>
    </div>
    <div class="col">
      <%= f.label :software_version do %>Preprint repository version<%= required_mark %><% end %>
      <%= f.text_field :software_version, class: "form-control", required: true %>
      <small class="form-text text-muted">Leave as v1.0.0 unless your repository has its own release tag.</small>
    </div>
  </div>
</div>

<div class="form-group">
  <div class="row">
    <div class="col">
      <%= f.label :submission_kind do %>Type of submission<%= required_mark %><% end %>
      <%= f.select(:submission_kind, {'New submission' => 'new', 'Resubmission' => 'resubmission', 'Major new version' => 'new version'}, {include_blank: false}, class: "form-control", style: "margin-right: 12px;") %>
    </div>
    <div class="col">
      <%= f.label :suggested_subject do %>Main subject of the paper<%= required_mark %><% end %>
      <%= f.select :suggested_subject, Subject.order(:name).pluck(:name), {prompt: "Select a subject"}, class: "form-control", required: true %>
      <small class="form-text text-muted">If your subject is not on the list, please <%= mail_to setting(:editor_email), "contact us" %>.</small>
    </div>
  </div>
</div>

<div class="form-group">
  <div class="row">
    <div class="col">
      <%= f.label :data_doi, "Preprint Data DOI (if exists)" %>
      <%= f.text_field :data_doi, placeholder: "If your data already have a DOI assigned, please enter (https://doi.org/xx.xxx/xxxxx)", class: "form-control" %>
    </div>
  </div>
</div>

<div class="form-group" id="published-parent-doi" style="display: none;">
  <div class="row">
    <div class="col">
      <%= f.label :published_parent_doi do %>
        <strong>DOI of the published version of the preprint</strong>
      <% end %>
      <%= f.text_field :published_parent_doi, placeholder: "Enter the existing DOI of your published preprint (e.g., https://doi.org/10.55458/neurolibre.12345)", class: "form-control" %>
    </div>
  </div>
</div>

<div class="form-group">
  <%= f.label :body do %>Message to editors<%= required_mark %><% end %>
  <%= f.text_area :body, rows: "7", required: true,
    placeholder: "Has any portion of the submitted work (which includes code and documentation) been published or submitted, or is planned for submission, to another peer-reviewed publication venue? If yes, please describe. Please also give short (1-2 line) description of your #{setting(:product)} including specific notes to the editor if this is a resubmission or a second paper in #{setting(:abbreviation)} about this #{setting(:product)}. Please disclose any potential conflicts of interest, including financial ones.", class: 'form-control' %>
</div>

<div class="form-group">
  <div class="row">
    <div class="col form-check" style="margin-left: 15px;">
      <input type="checkbox" id="author-check" class="pre-check form-check-input">
      <label class="form-check-label" for="author-check">I certify that I am submitting software for which I am a primary author</label>
    </div>
    <div class="col form-check" style="margin-left: 15px;">
      <input type="checkbox" id="paper-check" class="pre-check form-check-input">
      <label class="form-check-label" for="paper-check">I have verified that my paper compiles using one of <a href="https://joss.readthedocs.io/en/latest/submitting.html#checking-that-your-paper-compiles" target="_blank">these tools</a>.</label>
    </div>
    <div class="col form-check">
      <input type="checkbox" id="coc-check" class="pre-check form-check-input">
      <label class="form-check-label" for="coc-check">I confirm that I read and will adhere to the <%= setting(:abbreviation) %> <a href="/about#code_of_conduct" target="_blank">code of conduct</a></label>
    </div>
  </div>
</div>
<div class="form-actions">
  <%= submit_tag("Submit paper", class: "btn paper-submit disabled", disabled: "disabled", id: "author-submit") %>
</div>
<% end %>

<script>
// Runs as soon as Turbo renders the form, including after a failed submit.
// (A DOMContentLoaded listener only fires on a full page load.)
(function() {
  const submissionKindSelect = document.querySelector('#paper_submission_kind');
  const publishedParentDoiField = document.querySelector('#published-parent-doi');

  function togglePublishedParentDoi() {
    if (submissionKindSelect.value === 'resubmission') {
      publishedParentDoiField.style.display = 'block';
    } else {
      publishedParentDoiField.style.display = 'none';
    }
  }

  // Check initial state
  togglePublishedParentDoi();

  // Listen for changes
  submissionKindSelect.addEventListener('change', togglePublishedParentDoi);
})();
</script>
