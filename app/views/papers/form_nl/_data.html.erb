<section class="nl-section">
  <h2 class="nl-section-title">Data <span class="nl-optional">optional</span></h2>

  <div class="form-group mb-0">
    <%= f.label :data_doi, "Preprint data DOI" %>
    <%= f.text_field :data_doi, placeholder: "https://doi.org/xx.xxx/xxxxx", class: "form-control" %>
    <small class="form-text text-muted">If your data already have a DOI assigned, enter it here.</small>
  </div>
</section>
