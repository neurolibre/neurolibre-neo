<%# One paper in the grid: image, date, title, short authors, archive dots. %>
<article class="nl-recent__card">
  <%= link_to paper.seo_url, class: "nl-recent__card-image", tabindex: "-1", "aria-hidden": "true" do %>
    <%= image_tag pretty_card_image(paper), alt: "", loading: "lazy" %>
  <% end %>
  <div class="nl-recent__card-body">
    <span class="nl-recent__date"><%= nl_recent_date(paper) %></span>
    <h3><%= link_to paper.title, paper.seo_url %></h3>
    <p class="nl-recent__authors"><%= nl_recent_authors_short(paper) %></p>
    <div class="nl-recent__card-foot">
      <% layers = nl_recent_layers(paper) %>
      <span class="nl-recent__dots" aria-label="Archived: <%= layers.map { |l| l[:label].downcase }.to_sentence %>">
        <% layers.each do |layer| %><span class="nl-recent__dot nl-recent__dot--<%= layer[:kind] %>" title="<%= layer[:label] %>"></span><% end %>
      </span>
      <%= link_to "Open →", nl_recent_open_url(paper), class: "nl-recent__card-open", target: "_blank", rel: "noopener" %>
    </div>
  </div>
</article>
