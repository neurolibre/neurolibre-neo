
<%= render "home/hero_nl" %>

<div class="container">
<center><p class="lead"> Rooting for reproducible research. One publication at a time.<br>🌰 🌱 🌺</p></center>
<div class="announcement">
<p>NeuroLibre now hosts a ✨<a href="https://mystmd.org/guide/deployment">MyST server</a> ✨ to publish living preprints as dynamic pages, powered by structured data! <br> You can get started with this <a href="https://github.com/neurolibre/mystical-article">template repository</a>.</p>
</div>
</div>

<div class="container">
  <h4>Recently Published Reproducible Preprints <span class="badge-count"><%= Paper.visible.count %></span></h4>

  <div class="paper-list" id="all-papers">
    <% if request.user_agent =~ /Mobile/ %>
      <%= render partial: "papers/list", locals: { papers: @papers } %>
  <% else %>
    <%= render partial: "papers/list_nl", locals: { papers: @papers } %>
  <% end %>
  </div>
  </div>

  <div class="my-5 text-center">
    <%= link_to "View all papers".html_safe, published_papers_path, class: "btn", data: { text: "View all papers"} %>
  </div>
</div>
